# Square API Configuration
# Get these from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=
SQUARE_APP_ID=
SQUARE_LOCATION_ID=

# Set to 'production' when ready to go live, 'sandbox' for testing
SQUARE_ENV=sandbox

# Public Variables (exposed to browser)
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Your live domain
NEXT_PUBLIC_SITE_URL=https://sacredportalwellness.com

# Environment
NODE_ENV=development

# --- Additional Square fields (server-side) ---
# SQUARE_APPLICATION_ID is the canonical name used by the Square SDK; mirror SQUARE_APP_ID above.
SQUARE_APPLICATION_ID=
# SQUARE_ENVIRONMENT is the canonical name (sandbox|production); mirror SQUARE_ENV above.
SQUARE_ENVIRONMENT=production
# Pin to a specific Square API version to avoid surprise breaking changes.
SQUARE_VERSION=2025-11-19
# Webhook signature key (server-side HMAC verification of Square webhooks).
SQUARE_WEBHOOK_KEY=

# --- Cloudflare Turnstile (server-side verification) ---
TURNSTILE_SECRET=

# --- Optional: contact form notification email ---
CONTACT_NOTIFICATION_EMAIL=

# --- Production secrets management ---
# Local dev: copy to .env.local and fill in. NEVER commit .env.local.
# Production (Cloudflare Workers): use `wrangler secret put VAR_NAME` instead of committing values.
